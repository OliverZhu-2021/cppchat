# ── App / MySQL connection ─────────────────────────────────────────────────────
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=change_me_strong_password
DB_NAME=ChatHttpServer

# ── MySQL service ──────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_strong_password

# ── App / RabbitMQ connection ──────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me_strong_password

# ── ONNX image recognition model ──────────────────────────────────────────────
ONNX_MODEL_PATH=/root/models/mobilenetv2/mobilenetv2-7.onnx
ONNX_LABEL_PATH=/root/imagenet_classes.txt

# ── Alibaba Cloud DashScope (Aliyun AI / RAG / MCP strategies) ────────────────
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ByteDance DouBao AI ────────────────────────────────────────────────────────
DOUBAO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Alibaba Cloud RAG knowledge base ──────────────────────────────────────────
Knowledge_Base_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Baidu AI Cloud TTS ────────────────────────────────────────────────────────
BAIDU_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BAIDU_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
